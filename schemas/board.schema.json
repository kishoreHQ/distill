{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://distill.local/schemas/board.schema.json",
  "title": "Simulated advisory board",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "domain",
    "as_of",
    "disclaimer",
    "charter",
    "question",
    "members",
    "disagreements",
    "synthesis",
    "recommended_next_action",
    "confidence",
    "deliberation"
  ],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "domain": { "type": "string" },
    "as_of": { "type": "string" },
    "disclaimer": { "type": "string", "minLength": 40 },
    "charter": { "type": "string", "minLength": 40 },
    "question": { "type": "string", "minLength": 10 },
    "members": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile_id", "reason", "position", "evidence"],
        "properties": {
          "profile_id": { "type": "string" },
          "reason": { "type": "string" },
          "position": { "type": "string" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "url"],
              "properties": {
                "source": { "type": "string" },
                "url": { "type": "string", "minLength": 8 }
              }
            }
          }
        }
      }
    },
    "disagreements": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "synthesis": { "type": "string", "minLength": 40 },
    "recommended_next_action": { "type": "string", "minLength": 20 },
    "confidence": { "enum": ["high", "medium", "low"] },
    "deliberation": { "type": "string" }
  }
}
