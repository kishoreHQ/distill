{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://distill.local/schemas/post.schema.json",
  "title": "Post metadata row",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "created_at", "url", "text"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string" },
    "url": { "type": "string", "minLength": 8 },
    "text": { "type": "string", "maxLength": 280 },
    "pinned": { "type": "boolean" },
    "band": { "type": "string" },
    "origin": { "type": "string" },
    "metrics": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "like_count": { "type": ["integer", "null"], "minimum": 0 },
        "retweet_count": { "type": ["integer", "null"], "minimum": 0 },
        "reply_count": { "type": ["integer", "null"], "minimum": 0 },
        "quote_count": { "type": ["integer", "null"], "minimum": 0 },
        "bookmark_count": { "type": ["integer", "null"], "minimum": 0 },
        "impression_count": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  }
}
